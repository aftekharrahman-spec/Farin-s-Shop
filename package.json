{
  "name": "farins-kitchen",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api": "cd backend && php artisan serve --host=0.0.0.0 --port=8000",
    "api:queue": "cd backend && php artisan queue:work --sleep=1 --tries=3 --timeout=30",
    "api:test": "cd backend && php artisan test",
    "api:seed": "cd backend && php artisan migrate --seed"
  },
  "private": true
}
